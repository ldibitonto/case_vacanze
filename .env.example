# Postgres — sostituisci con la tua connection string
# Locale:   postgresql://postgres:postgres@localhost:5432/case_vacanze?schema=public
# Neon (consigliato con Vercel): usa la connection string POOLED per l'app (DATABASE_URL)
# e quella DIRETTA per le migration (DIRECT_URL) — vedi schema.prisma e sezione
# "Deploy su Vercel" nel README.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/case_vacanze?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/case_vacanze?schema=public"

# Provider di pagamento: "mock" (default, nessuna chiave necessaria) oppure "stripe" (da implementare)
PAYMENT_PROVIDER="mock"

# Quando passerai a Stripe in modalita' test, aggiungerai qui le chiavi sk_test_... / pk_test_...
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# URL base dell'app, usato per costruire i link di ritorno dal checkout
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Email di conferma prenotazione (inviata via Resend, https://resend.com — piano
# gratuito: 100 email/giorno, nessuna carta richiesta). Senza questa chiave
# l'email viene solo loggata in console, non inviata davvero.
# 1. Crea un account su resend.com
# 2. Crea una API key e incollala qui sotto
# 3. Se non hai ancora verificato un tuo dominio su Resend, lascia EMAIL_FROM
#    com'è: "onboarding@resend.dev" funziona subito per i test.
RESEND_API_KEY=""
EMAIL_FROM="Case Vacanze <onboarding@resend.dev>"

# Credenziali per proteggere /admin e /admin/properties (HTTP Basic Auth,
# vedi src/middleware.ts). Senza queste due variabili l'area admin è
# bloccata di default, per errore prudente.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
